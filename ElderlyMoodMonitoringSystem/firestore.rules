// DEVELOPMENT RULES – FULLY PERMISSIVE
// These rules allow all reads and writes. They should only be used for local
// development or demonstration purposes. Do NOT deploy these rules to a
// production project. If you need to deploy to a demo project, review them
// carefully first.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
